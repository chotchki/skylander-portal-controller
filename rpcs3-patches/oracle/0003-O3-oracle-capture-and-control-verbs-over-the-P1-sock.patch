+// O3 (oracle, PAUSE_AT): the flip to pause at, 0 for none. Only the GUAC_ORACLE=1 IPC verb sets it.
+atomic_t<u64> g_oracle_pause_at_flip = 0;
 atomic_t<bool> g_disable_frame_limit = false;
 rsx::frame_trace_data frame_debug;
 rsx::frame_capture_data frame_capture;
@@ -833,6 +835,7 @@ namespace rsx
 		m_graphics_state |= pipeline_state::all_dirty;
 
 		g_user_asked_for_frame_capture = false;
+		g_oracle_pause_at_flip = 0; // O3: a target never outlives its session's flip count
 
 		// TODO: Proper context management in the driver
 		s_ctx.rsxthr = this;
@@ -2716,6 +2719,21 @@ namespace rsx
 			{
 				Emu.Pause();
 			}
+
+			// O3 (oracle, PAUSE_AT): pause at the target flip, where Start Paused pauses. The target is
+			// absolute and checked here, on the RSX thread, so the IPC thread setting it can't race this
+			// flip the way a relative count would. A target already passed is dropped, never late.
+			if (const u64 at = g_oracle_pause_at_flip; at && int_flip_index >= at && g_oracle_pause_at_flip.compare_and_swap_test(at, 0))
+			{
+				if (int_flip_index == at)
+				{
+					Emu.Pause();
+				}
+				else
+				{
+					rsx_log.error("Oracle: PAUSE_AT %u passed (the flip counter is at %u)", at, int_flip_index);
+				}
+			}
 		}
 
 		last_host_flip_timestamp = get_system_time();
