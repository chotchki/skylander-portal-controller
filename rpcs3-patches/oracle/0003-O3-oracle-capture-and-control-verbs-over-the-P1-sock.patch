+	// --- O3: the oracle's capture and control verbs (openspec AF.5) ----------
+	// Dev-only (rpcs3-patches/oracle/, never in a product build). Each answers P1's
+	// `ERR unknown_cmd` unless GUAC_ORACLE=1 is in the emulator's environment, so a
+	// client that doesn't set it sees the product protocol. Nothing here knows the
+	// game: the flip counter is RSX's int_flip_index, the one STATE and HB report.
+	bool sky_oracle_gate()
+	{
+		static const bool on = []
+		{
+			const char* v = std::getenv("GUAC_ORACLE");
+			return v && std::string_view(v) == "1";
+		}();
+		return on;
+	}
+
+	// A decimal flip number, digits only; false on anything else.
+	bool sky_parse_flip(const std::string& arg, u64& out)
+	{
+		if (arg.empty() || arg.size() > 19)
+			return false;
+		u64 v = 0;
+		for (const char c : arg)
+		{
+			if (c < '0' || c > '9')
+				return false;
+			v = v * 10 + static_cast<u64>(c - '0');
+		}
+		out = v;
+		return true;
+	}
+
+	// Handles an O-verb into `out`; false when `cmd` isn't one.
+	bool sky_oracle_handle(const std::string& cmd, const std::string& arg, std::string& out)
+	{
+		if (cmd == "PAUSE_AT")
+		{
+			// "PAUSE_AT <flip>": pause when the flip counter reaches <flip>, so STATE then reads
+			// status=paused frames=<flip>. The RSX thread checks the target at every guest flip
+			// (O3's hook in rsx::thread::flip, beside Start Paused's count), so it lands exactly.
+			u64 at = 0;
+			rsx::thread* r = rsx::get_current_renderer();
+			if (!sky_parse_flip(arg, at) || at == 0)
+				out = "ERR bad_flip\n";
+			else if (!r)
+				out = "ERR no_renderer\n";
+			else if (at <= r->int_flip_index)
+				out = "ERR past\n";
+			else
+			{
+				g_oracle_pause_at_flip = at;
+				// A flip reaching the target between the check and the store went by unseen:
+				// withdraw it rather than leave the RSX thread to drop it.
+				if (at <= r->int_flip_index && g_oracle_pause_at_flip.compare_and_swap_test(at, 0))
+					out = "ERR past\n";
+				else
+					out = "OK\n";
+			}
+			return true;
+		}
+		if (cmd == "RESUME")
+		{
+			// Resume on the main thread, as the GUI's pause toggle does; OK once it has run.
+			// BlockingCallFromMainThread's own wait, without its error line for a caller that
+			// isn't a named_thread (this connection thread isn't).
+			if (Emu.GetStatus() != system_state::paused)
+			{
+				out = "ERR not_paused\n";
+				return true;
+			}
+			atomic_t<u32> done = 0;
+			Emu.CallFromMainThread([] { Emu.Resume(); }, &done);
+			while (!done)
+				done.wait(0);
+			out = "OK\n";
+			return true;
+		}
+		if (cmd == "RSXCAP")
+		{
+			// The flag the game window's capture shortcut sets (gs_frame.cpp). RSX arms at the next
+			// frame end, records the frame after it, writes captures/<TITLE>_<time>_capture.rrc.gz
+			// at that frame's end and pauses. Armed at a pause at flip n, STATE reads n+1 once it
+			// lands (AF.5's runs, Giants on the Mac).
+			rsx::thread* r = rsx::get_current_renderer();
+			if (!r)
+				out = "ERR no_renderer\n";
+			else if (r->capture_current_frame || g_user_asked_for_frame_capture.exchange(true))
+				out = "ERR busy\n";
+			else
+				out = "OK\n";
+			return true;
+		}
+		if (cmd == "SCREENSHOT")
+		{
+			// The flag the screenshot shortcut sets. The renderer's next present takes the frame
+			// (VKGSRender::flip copies the guest's display buffer out of the surface cache) and
+			// gs_frame::take_screenshot writes screenshots/<TITLE>/<TITLE>_screenshot_<time>.png on
+			// a thread of its own. While paused no guest flip comes, so ask RSX for a native-UI
+			// flip, which re-presents the current display buffer: the shot is the frame the counter
+			// names. Replies `OK flip=<n>` once a present has taken the request (exact at a pause;
+			// running, the counter as this thread saw it just after).
+			rsx::thread* r = rsx::get_current_renderer();
+			if (!r)
+			{
+				out = "ERR no_renderer\n";
+				return true;
+			}
+			if (g_user_asked_for_screenshot.exchange(true))
+			{
+				out = "ERR busy\n";
+				return true;
+			}
+			const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+			while (g_user_asked_for_screenshot)
+			{
+				if (std::chrono::steady_clock::now() > deadline)
+				{
+					// No present took it: withdraw the request, unless one did just now.
+					if (g_user_asked_for_screenshot.exchange(false))
+					{
+						out = "ERR timeout\n";
+						return true;
+					}
+					break;
+				}
+				if (Emu.IsPaused())
+					rsx::set_native_ui_flip();
+				std::this_thread::sleep_for(std::chrono::milliseconds(1));
+			}
+			out = "OK flip=" + std::to_string(r->int_flip_index) + "\n";
+			return true;
+		}
+		if (cmd == "SAVESTATE")
+		{
+			// The game window's savestate shortcut (gs_frame.cpp, gw_savestate) on the main thread.
+			// With Suspend Emulation Savestate Mode off the emulator stops, writes a new
+			// savestates/<TITLE>/<TITLE>_*.SAVESTAT.zst and boots it again, where Start Paused holds
+			// it 2 flips in. The portal's USB device goes with the old session, so the client sends
+			// P5's RECONNECT after. OK means the save was asked for, not that it landed.
+			const system_state s = Emu.GetStatus();
+			if (s != system_state::running && s != system_state::paused)
+			{
+				out = "ERR not_running\n";
+				return true;
+			}
+			Emu.CallFromMainThread([]
+			{
+				if (!g_cfg.savestate.suspend_emu)
+				{
+					Emu.after_kill_callback = []
+					{
+						Emu.Restart(true, false);
+					};
+					Emu.SetContinuousMode(true);
+				}
+				Emu.Kill(false, true);
+			});
+			out = "OK\n";
+			return true;
+		}
+		return false;
+	}
+
 	void sky_ipc_handle(const std::string& line, std::string& out)
 	{
 		const usz sp = line.find(' ');
@@ -639,6 +812,10 @@ namespace
 			sky_force_pad_button(offset, bit, false);
 			out = "OK\n";
 		}
+		else if (sky_oracle_gate() && sky_oracle_handle(cmd, arg, out))
+		{
+			// O3: an oracle verb, answered above.
+		}
 		else
 		{
 			out = "ERR unknown_cmd\n";
