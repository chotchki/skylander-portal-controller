+// --- O4: the oracle's frame-locked input (openspec AF.7) -------------------
+// Dev-only (rpcs3-patches/oracle/, never in a product build). P1's socket (Skylander.cpp) loads a
+// schedule per port here: from a flip on, port 0 or 1 reads these digital words and stick axes,
+// held until that port's next entry. pad_get_data applies the entry for the flip its read happens
+// in, so every read the guest makes while a flip is current sees that flip's entry whatever the
+// pad thread's host poll did, and it records what the guest read for PAD_STATE. Inert unless
+// GUAC_ORACLE=1 is in the emulator's environment. All of it is guarded by pad::g_pad_mutex, which
+// cellPadGetData and cellPadPeriphGetData hold around pad_get_data and the verbs below take; the
+// flip is RSX's int_flip_index, the counter STATE and HB report. Nothing here knows the game.
+namespace
+{
+	// One port's state: CELL_PAD_CTRL_* words and the four stick axes (0-255, 128 centred).
+	struct oracle_pad_entry
+	{
+		u16 d1 = 0;
+		u16 d2 = 0;
+		u16 lx = 128;
+		u16 ly = 128;
+		u16 rx = 128;
+		u16 ry = 128;
+
+		bool operator==(const oracle_pad_entry&) const = default;
+	};
+
+	// The guest's reads of one port during one flip: how many, the first one's state, and how many
+	// of the rest differed from it.
+	struct oracle_pad_flip_reads
+	{
+		u64 flip = umax;
+		u32 reads = 0;
+		u32 differ = 0;
+		oracle_pad_entry first{};
+	};
+
+	constexpr u32 oracle_pad_ports = 2;
+	constexpr usz oracle_pad_history = 4096; // flips of reads kept per port, about 68 s at 60 fps
+	constexpr usz oracle_pad_max_entries = 1u << 16;
+
+	struct oracle_pad_state
+	{
+		u64 session = 0; // the Emu.GetEmulationIdentifier() everything below belongs to
+		std::map<u64, oracle_pad_entry> schedule[oracle_pad_ports];
+		std::array<oracle_pad_flip_reads, oracle_pad_history> history[oracle_pad_ports]{};
+		u64 last_flip[oracle_pad_ports]{umax, umax};
+		oracle_pad_entry last[oracle_pad_ports]{};
+	};
+
+	oracle_pad_state g_oracle_pad;
+
+	bool oracle_pad_gate()
+	{
+		static const bool on = []
+		{
+			const char* v = std::getenv("GUAC_ORACLE");
+			return v && std::string_view(v) == "1";
+		}();
+		return on;
+	}
+
+	// A new emulation session (a boot, a savestate's reboot) counts flips from 0 again: drop what
+	// the old one loaded and read.
+	void oracle_pad_session()
+	{
+		const u64 id = static_cast<u64>(Emu.GetEmulationIdentifier());
+		if (g_oracle_pad.session == id)
+			return;
+		g_oracle_pad.session = id;
+		for (u32 p = 0; p < oracle_pad_ports; p++)
+		{
+			g_oracle_pad.schedule[p].clear();
+			g_oracle_pad.history[p].fill({});
+			g_oracle_pad.last_flip[p] = umax;
+			g_oracle_pad.last[p] = {};
+		}
+	}
+
+	// The flip a read belongs to; 0 with the gate off or before RSX is up.
+	u64 oracle_pad_flip()
+	{
+		if (!oracle_pad_gate())
+			return 0;
+		const rsx::thread* r = rsx::get_current_renderer();
+		return r ? r->int_flip_index : 0;
+	}
+
+	// The entry the port reads at `flip`, or nullptr for the host's input.
+	const oracle_pad_entry* oracle_pad_entry_at(u32 port, u64 flip)
+	{
+		if (!oracle_pad_gate() || port >= oracle_pad_ports)
+			return nullptr;
+		oracle_pad_session();
+		const auto& schedule = g_oracle_pad.schedule[port];
+		const auto next = schedule.upper_bound(flip);
+		return next == schedule.begin() ? nullptr : &std::prev(next)->second;
+	}
+
+	// The scheduled state into `output`, through pad_get_data's own change check. Pressed buttons
+	// read full pressure, as P6's forced presses do.
+	template <typename SetValue>
+	void oracle_pad_apply(CellPadData& output, const oracle_pad_entry& e, SetValue&& set_value)
+	{
+		struct press
+		{
+			bool d2;
+			u16 bit;
+			u32 offset;
+		};
+		static constexpr press presses[] = {
+			{false, CELL_PAD_CTRL_LEFT, CELL_PAD_BTN_OFFSET_PRESS_LEFT},
+			{false, CELL_PAD_CTRL_DOWN, CELL_PAD_BTN_OFFSET_PRESS_DOWN},
+			{false, CELL_PAD_CTRL_RIGHT, CELL_PAD_BTN_OFFSET_PRESS_RIGHT},
+			{false, CELL_PAD_CTRL_UP, CELL_PAD_BTN_OFFSET_PRESS_UP},
+			{true, CELL_PAD_CTRL_SQUARE, CELL_PAD_BTN_OFFSET_PRESS_SQUARE},
+			{true, CELL_PAD_CTRL_CROSS, CELL_PAD_BTN_OFFSET_PRESS_CROSS},
+			{true, CELL_PAD_CTRL_CIRCLE, CELL_PAD_BTN_OFFSET_PRESS_CIRCLE},
+			{true, CELL_PAD_CTRL_TRIANGLE, CELL_PAD_BTN_OFFSET_PRESS_TRIANGLE},
+			{true, CELL_PAD_CTRL_R1, CELL_PAD_BTN_OFFSET_PRESS_R1},
+			{true, CELL_PAD_CTRL_L1, CELL_PAD_BTN_OFFSET_PRESS_L1},
+			{true, CELL_PAD_CTRL_R2, CELL_PAD_BTN_OFFSET_PRESS_R2},
+			{true, CELL_PAD_CTRL_L2, CELL_PAD_BTN_OFFSET_PRESS_L2},
+		};
+		output.button[CELL_PAD_BTN_OFFSET_DIGITAL1] = e.d1;
+		output.button[CELL_PAD_BTN_OFFSET_DIGITAL2] = e.d2;
+		for (const press& p : presses)
+		{
+			set_value(output.button[p.offset], static_cast<u16>(((p.d2 ? e.d2 : e.d1) & p.bit) ? 255 : 0));
+		}
+		set_value(output.button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X], e.lx);
+		set_value(output.button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y], e.ly);
+		set_value(output.button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X], e.rx);
+		set_value(output.button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y], e.ry);
+	}
+
+	// What the guest holds after a read (`output` changes only with a report that carries it).
+	void oracle_pad_record(u32 port, u64 flip, const CellPadData& output)
+	{
+		if (!oracle_pad_gate() || port >= oracle_pad_ports)
+			return;
+		oracle_pad_session();
+		const oracle_pad_entry got{
+			output.button[CELL_PAD_BTN_OFFSET_DIGITAL1],
+			output.button[CELL_PAD_BTN_OFFSET_DIGITAL2],
+			output.button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X],
+			output.button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y],
+			output.button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X],
+			output.button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y],
+		};
+		oracle_pad_flip_reads& h = g_oracle_pad.history[port][flip % oracle_pad_history];
+		if (h.flip != flip)
+		{
+			h = {flip, 1, 0, got};
+		}
+		else
+		{
+			h.reads++;
+			if (got != h.first)
+				h.differ++;
+		}
+		g_oracle_pad.last_flip[port] = flip;
+		g_oracle_pad.last[port] = got;
+	}
+}
+
+// O4: a PAD entry for `port` from `flip` on; nullptr once it's in, else the ERR reason.
+const char* oracle_pad_set(u32 port, u64 flip, u16 d1, u16 d2, u16 lx, u16 ly, u16 rx, u16 ry)
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	if (port >= oracle_pad_ports)
+		return "bad_port";
+	oracle_pad_session();
+	const rsx::thread* r = rsx::get_current_renderer();
+	if (!r)
+		return "no_renderer";
+	// No read runs while this holds the mutex, and every read takes the counter under it, so a flip
+	// still ahead of the counter here has had no read yet: all of its reads see this entry. Reads
+	// of the current flip may already have happened, so it's past.
+	if (flip <= r->int_flip_index)
+		return "past";
+	auto& schedule = g_oracle_pad.schedule[port];
+	if (!schedule.contains(flip) && schedule.size() >= oracle_pad_max_entries)
+		return "full";
+	schedule[flip] = {d1, d2, lx, ly, rx, ry};
+	return nullptr;
+}
+
+// O4: PAD_CLEAR. Both ports read the host's input again; what the guest read stays readable.
+void oracle_pad_clear()
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_pad_session();
+	for (auto& schedule : g_oracle_pad.schedule)
+		schedule.clear();
+}
+
+// O4: PAD_STATE. `flip` umax: the guest's last read on `port`, with the read count of its flip.
+// Otherwise that flip's first read, its read count and how many reads differed from the first;
+// false when the guest made no read in it (or it's older than the history keeps).
+bool oracle_pad_read(u32 port, u64 flip, u64& at, u32& reads, u32& differ, u16 (&words)[6])
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	if (port >= oracle_pad_ports)
+		return false;
+	oracle_pad_session();
+	const bool last = flip == umax;
+	at = last ? g_oracle_pad.last_flip[port] : flip;
+	if (at == umax)
+		return false;
+	const oracle_pad_flip_reads& h = g_oracle_pad.history[port][at % oracle_pad_history];
+	if (h.flip != at)
+		return false;
+	const oracle_pad_entry& e = last ? g_oracle_pad.last[port] : h.first;
+	reads = h.reads;
+	differ = h.differ;
+	words[0] = e.d1;
+	words[1] = e.d2;
+	words[2] = e.lx;
+	words[3] = e.ly;
+	words[4] = e.rx;
+	words[5] = e.ry;
+	return true;
+}
