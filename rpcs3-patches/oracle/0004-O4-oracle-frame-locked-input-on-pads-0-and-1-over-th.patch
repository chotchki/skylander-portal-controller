+				std::snprintf(line, sizeof(line), "OK flip=%llu reads=%u differ=%u d1=%02x d2=%02x lx=%u ly=%u rx=%u ry=%u\n",
+					static_cast<unsigned long long>(at), reads, differ, unsigned{s[0]}, unsigned{s[1]}, unsigned{s[2]}, unsigned{s[3]},
+					unsigned{s[4]}, unsigned{s[5]});
+				out = line;
+			}
+			return true;
+		}
+		return false;
+	}
