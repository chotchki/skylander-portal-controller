+	// --- O4: the oracle's frame-locked input (openspec AF.7) ----------------
+	// Behind the same gate as O3. A schedule entry per port says what the guest reads from a flip on,
+	// held until that port's next entry; cellPad's pad_get_data applies it, so every read the guest
+	// makes while a flip is current sees that flip's entry, whatever the host's pad poll did. Load a
+	// schedule while paused (Start Paused or PAUSE_AT): an entry has to be ahead of the counter.
+
+	// `arg` split on single spaces.
+	std::vector<std::string> sky_words(const std::string& arg)
+	{
+		std::vector<std::string> words;
+		usz at = 0;
+		while (true)
+		{
+			const usz sp = arg.find(' ', at);
+			words.push_back(arg.substr(at, sp == umax ? umax : sp - at));
+			if (sp == umax)
+				return words;
+			at = sp + 1;
+		}
+	}
+
+	// 1 to `digits` characters of `base` (10 or 16) no greater than `max`.
+	bool sky_parse_num(const std::string& s, u32 base, usz digits, u32 max, u32& out)
+	{
+		if (s.empty() || s.size() > digits)
+			return false;
+		u32 v = 0;
+		for (const char c : s)
+		{
+			u32 d;
+			if (c >= '0' && c <= '9')
+				d = static_cast<u32>(c - '0');
+			else if (base == 16 && c >= 'a' && c <= 'f')
+				d = static_cast<u32>(c - 'a' + 10);
+			else if (base == 16 && c >= 'A' && c <= 'F')
+				d = static_cast<u32>(c - 'A' + 10);
+			else
+				return false;
+			v = v * base + d;
+		}
+		if (v > max)
+			return false;
+		out = v;
+		return true;
+	}
+
+	bool sky_oracle_pad_handle(const std::string& cmd, const std::string& arg, std::string& out)
+	{
+		if (cmd == "PAD")
+		{
+			// "PAD <port> <flip> <d1> <d2> <lx> <ly> <rx> <ry>": from <flip> on, port 0 or 1 reads
+			// CELL_PAD_CTRL_* words d1 and d2 (hex, PS button and above refused) and the stick axes
+			// (decimal 0-255, 128 centred), held until that port's next entry. Replaces whatever the
+			// port had at <flip>. Pressed buttons read full pressure.
+			const std::vector<std::string> w = sky_words(arg);
+			u32 port = 0, d1 = 0, d2 = 0, axis[4]{};
+			u64 flip = 0;
+			if (w.size() != 8)
+				out = "ERR bad_args\n";
+			else if (!sky_parse_num(w[0], 10, 1, 1, port))
+				out = "ERR bad_port\n";
+			else if (!sky_parse_flip(w[1], flip) || flip == 0)
+				out = "ERR bad_flip\n";
+			else if (!sky_parse_num(w[2], 16, 4, 0xff, d1) || !sky_parse_num(w[3], 16, 4, 0xff, d2))
+				out = "ERR bad_button\n";
+			else if (!sky_parse_num(w[4], 10, 3, 255, axis[0]) || !sky_parse_num(w[5], 10, 3, 255, axis[1]) ||
+				!sky_parse_num(w[6], 10, 3, 255, axis[2]) || !sky_parse_num(w[7], 10, 3, 255, axis[3]))
+				out = "ERR bad_axis\n";
+			else if (const char* err = oracle_pad_set(port, flip, static_cast<u16>(d1), static_cast<u16>(d2),
+				static_cast<u16>(axis[0]), static_cast<u16>(axis[1]), static_cast<u16>(axis[2]), static_cast<u16>(axis[3])))
+				out = std::string("ERR ") + err + "\n";
+			else
+				out = "OK\n";
+			return true;
+		}
+		if (cmd == "PAD_CLEAR")
+		{
+			// Drops both ports' schedules: the guest reads the host's input (and P6's presses) again.
+			if (!arg.empty())
+			{
+				out = "ERR bad_args\n";
+				return true;
+			}
+			oracle_pad_clear();
+			out = "OK\n";
+			return true;
+		}
+		if (cmd == "PAD_STATE")
+		{
+			// "PAD_STATE <port>": what the guest last read on that port, the flip it read it in and how
+			// many reads it made in that flip. "PAD_STATE <port> <flip>": that flip's first read, with
+			// the count. Either way differ= counts the flip's reads that weren't its first read's state.
+			const std::vector<std::string> w = arg.empty() ? std::vector<std::string>{} : sky_words(arg);
+			u32 port = 0;
+			u64 flip = umax;
+			if (w.empty() || w.size() > 2)
