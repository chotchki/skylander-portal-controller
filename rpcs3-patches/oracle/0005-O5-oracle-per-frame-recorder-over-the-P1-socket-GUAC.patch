+// --- O5: the oracle's per-frame recorder (openspec AG.1, AG.35) -------------
+// Dev-only (rpcs3-patches/oracle/, never in a product build). P1's socket (Skylander.cpp) arms a
+// watch here: guest address ranges and a pad port the client names, copied into a bounded ring at
+// EVERY read of that port, on the guest thread making the read and under pad::g_pad_mutex, where
+// O4 keys the flip. A game that reads the port once a frame gets one record a frame wherever its
+// frames fall against the flips: a flip that runs two frames holds two records, and one that runs
+// none holds none (AG.35: a record at each flip's first read lost the second frame). Each record
+// keeps the flip and which of the port's reads in that flip it was, so the first of each flip is
+// the record a flip-keyed observer reads. Nothing pauses to observe, so the run isn't moved by it
+// the way a PAUSE_AT checkpoint moves it. Inert unless GUAC_ORACLE=1. Nothing here knows the
+// game: the client says what to copy and on which port's reads.
+namespace
+{
+	constexpr usz oracle_watch_max_ranges = 64;      // one bit each in a record's missing mask
+	constexpr u32 oracle_watch_max_bytes = 16384;    // payload a record
+	constexpr u32 oracle_watch_max_frames = 1u << 20;
+	constexpr u64 oracle_watch_budget = 16u << 20;   // the ring, records and headers
+	constexpr u32 oracle_watch_header = 32;          // flip, host microseconds, missing mask, read
+	constexpr u64 oracle_watch_reply = 32768;        // record bytes a WATCH_READ reply carries
+
+	struct oracle_watch_range
+	{
+		u32 addr;
+		u32 len;
+	};
+
+	// One port's reads: the flip of its latest read and how many it has had in that flip.
+	struct oracle_watch_port
+	{
+		u64 flip = umax;
+		u64 reads = 0;
+	};
+
+	struct oracle_watch_state
+	{
+		u64 session = 0;      // the Emu.GetEmulationIdentifier() everything below belongs to
+		std::array<oracle_watch_port, CELL_PAD_MAX_PORT_NUM> ports{}; // counted armed or not
+		u32 port = 0;         // the port whose reads record
+		u64 from_flip = 0;    // the first flip recorded, so a ring starts on a whole flip
+		std::vector<oracle_watch_range> ranges;
+		u32 bytes = 0;        // payload a record: the ranges back to back
+		u32 frames = 0;       // records the ring holds; 0 when nothing is armed
+		u64 armed_at = 0;     // the flip counter when it was armed
+		u64 total = 0;        // records taken since
+		std::vector<u8> ring;
+	};
+
+	oracle_watch_state g_oracle_watch;
+
+	// A new emulation session counts flips from 0 again: drop the watch, its ring and the counts.
+	void oracle_watch_session()
+	{
+		const u64 id = static_cast<u64>(Emu.GetEmulationIdentifier());
+		if (g_oracle_watch.session == id)
+			return;
+		g_oracle_watch = {};
+		g_oracle_watch.session = id;
+	}
+
+	void oracle_watch_put_be(u8* at, u64 v)
+	{
+		for (int i = 7; i >= 0; i--, v >>= 8)
+			at[i] = static_cast<u8>(v);
+	}
+
+	// Every pad read, before anything else in it: the read is counted against its port and flip,
+	// and a read of the watched port from the first recorded flip on copies the watched ranges
+	// into the next record (the oldest one once the ring is full). A range that isn't readable at
+	// that moment reads as zeros with its bit set in the record's missing mask.
+	void oracle_watch_read(u32 port, u64 flip)
+	{
+		if (!oracle_pad_gate() || port >= CELL_PAD_MAX_PORT_NUM)
+			return;
+		oracle_watch_session();
+		oracle_watch_state& w = g_oracle_watch;
+		oracle_watch_port& p = w.ports[port];
+		if (p.flip != flip)
+		{
+			p.flip = flip;
+			p.reads = 0;
+		}
+		const u64 read = p.reads++;
+		if (!w.frames || port != w.port || flip < w.from_flip)
+			return;
+		const usz stride = oracle_watch_header + w.bytes;
+		u8* const rec = w.ring.data() + (w.total % w.frames) * stride;
+		u8* out = rec + oracle_watch_header;
+		u64 missing = 0;
+		for (usz i = 0; i < w.ranges.size(); i++)
+		{
+			const oracle_watch_range& r = w.ranges[i];
+			if (vm::check_addr(r.addr, vm::page_readable, r.len))
+			{
+				std::memcpy(out, vm::base(r.addr), r.len);
+			}
+			else
+			{
+				std::memset(out, 0, r.len);
+				missing |= u64{1} << i;
+			}
+			out += r.len;
+		}
+		const auto us = std::chrono::duration_cast<std::chrono::microseconds>(steady_clock::now().time_since_epoch()).count();
+		oracle_watch_put_be(rec, flip);
+		oracle_watch_put_be(rec + 8, static_cast<u64>(us));
+		oracle_watch_put_be(rec + 16, missing);
+		oracle_watch_put_be(rec + 24, read);
+		w.total++;
+	}
+}
+
+// O5: WATCH. Arms a ring of `frames` records of `ranges` (each an address and a length), one at
+// every read of `port`, replacing any watch before it. Recording starts on a whole flip: this one
+// when `port` hasn't been read in it yet, else the next. nullptr once armed (`bytes` is a
+// record's payload), else the ERR reason.
+const char* oracle_watch_arm(u32 frames, u32 port, const std::vector<std::pair<u32, u32>>& ranges, u32& bytes)
+{
+	if (frames == 0 || frames > oracle_watch_max_frames)
+		return "bad_frames";
+	if (port >= CELL_PAD_MAX_PORT_NUM)
+		return "bad_port";
+	if (ranges.empty() || ranges.size() > oracle_watch_max_ranges)
+		return "bad_args";
+	u64 total = 0;
+	for (const auto& [addr, len] : ranges)
+	{
+		if (len == 0 || len > oracle_watch_max_bytes || u64{addr} + len > 0x1'0000'0000ull)
+			return "bad_range";
+		total += len;
+	}
+	if (total > oracle_watch_max_bytes || u64{frames} * (oracle_watch_header + total) > oracle_watch_budget)
+		return "too_big";
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_watch_session();
+	const rsx::thread* r = rsx::get_current_renderer();
+	if (!r)
+		return "no_renderer";
+	for (const auto& [addr, len] : ranges)
+	{
+		if (!vm::check_addr(addr, vm::page_readable, len))
+			return "unmapped";
+	}
+	oracle_watch_state& w = g_oracle_watch;
+	const u64 now = r->int_flip_index;
+	w.ranges.clear();
+	for (const auto& [addr, len] : ranges)
+		w.ranges.push_back({addr, len});
+	w.port = port;
+	w.from_flip = w.ports[port].flip == now ? now + 1 : now;
+	w.bytes = static_cast<u32>(total);
+	w.frames = frames;
+	w.armed_at = now;
+	w.total = 0;
+	w.ring.assign(static_cast<usz>(frames) * (oracle_watch_header + total), 0);
+	bytes = w.bytes;
+	return nullptr;
+}
+
+// O5: WATCH_CLEAR. The watch and its ring dropped; the ports' read counts stay.
+void oracle_watch_clear()
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_watch_session();
+	const u64 session = g_oracle_watch.session;
+	const auto ports = g_oracle_watch.ports;
+	g_oracle_watch = {};
+	g_oracle_watch.session = session;
+	g_oracle_watch.ports = ports;
+}
+
+// O5: WATCH_READ. `summary`: the ring's held and total record counts, a record's payload, its size,
+// the counter when it was armed and the port it records. Otherwise records `first` to
+// `first + count` of those held (0 the oldest), as hex. Into `out` with its newline; nullptr on
+// success, else the ERR reason.
+const char* oracle_watch_records(bool summary, u64 first, u64 count, std::string& out)
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_watch_session();
+	const oracle_watch_state& w = g_oracle_watch;
+	if (!w.frames)
+		return "no_watch";
+	const u64 held = std::min<u64>(w.total, w.frames);
+	if (summary)
+	{
+		out = "OK held=" + std::to_string(held) + " total=" + std::to_string(w.total) + " bytes=" + std::to_string(w.bytes) +
+			" frames=" + std::to_string(w.frames) + " armed=" + std::to_string(w.armed_at) + " port=" + std::to_string(w.port) + "\n";
+		return nullptr;
+	}
+	const u64 stride = oracle_watch_header + w.bytes;
+	if (count == 0)
+		return "bad_count";
+	if (first >= held || count > held - first)
+		return "bad_index";
+	if (count > oracle_watch_reply / stride)
+		return "bad_count";
+	static constexpr char digits[] = "0123456789abcdef";
+	out = "OK first=" + std::to_string(first) + " count=" + std::to_string(count) + " data=";
+	out.reserve(out.size() + count * stride * 2 + 1);
+	const u64 oldest = w.total - held;
+	for (u64 i = first; i < first + count; i++)
+	{
+		const u8* rec = w.ring.data() + ((oldest + i) % w.frames) * stride;
+		for (u64 b = 0; b < stride; b++)
+		{
+			out += digits[rec[b] >> 4];
+			out += digits[rec[b] & 15];
+		}
+	}
+	out += "\n";
+	return nullptr;
+}
