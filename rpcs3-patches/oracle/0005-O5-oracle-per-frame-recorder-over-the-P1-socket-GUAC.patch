+	// --- O5: the oracle's per-frame recorder (openspec AG.1, AG.35) ---------
+	// Behind the same gate as O3. WATCH names guest ranges, a pad port and a ring size; from the
+	// next whole flip on, every read of that port copies those ranges into the ring (cellPad.cpp),
+	// so a run that reads the port once a frame records every frame without pausing. WATCH_READ
+	// hands the ring back at a pause, WATCH_CLEAR drops it.
+
+	bool sky_oracle_watch_handle(const std::string& cmd, const std::string& arg, std::string& out)
+	{
+		if (cmd == "WATCH")
+		{
+			// "WATCH <frames> <port> <addr> <len> [<addr> <len> ...]": a ring of <frames> records,
+			// each the ranges' bytes back to back (address hex, length decimal), taken at every read
+			// of pad port <port> (0-6, CELL_PAD_MAX_PORT_NUM's) from the next whole flip on. Replaces
+			// any watch before it.
+			const std::vector<std::string> w = arg.empty() ? std::vector<std::string>{} : sky_words(arg);
+			if (w.size() < 4 || (w.size() - 2) % 2 != 0 || (w.size() - 2) / 2 > 64)
+			{
+				out = "ERR bad_args\n";
+				return true;
+			}
+			u32 frames = 0, port = 0;
+			if (!sky_parse_num(w[0], 10, 7, 0xffffffffu, frames))
+			{
+				out = "ERR bad_frames\n";
+				return true;
+			}
+			if (!sky_parse_num(w[1], 10, 1, 6, port))
+			{
+				out = "ERR bad_port\n";
+				return true;
+			}
+			std::vector<std::pair<u32, u32>> ranges;
+			for (usz i = 2; i + 1 < w.size(); i += 2)
+			{
+				u32 addr = 0, len = 0;
+				if (!sky_parse_num(w[i], 16, 8, 0xffffffffu, addr) || !sky_parse_num(w[i + 1], 10, 5, 0xffffffffu, len))
+				{
+					out = "ERR bad_range\n";
+					return true;
+				}
+				ranges.emplace_back(addr, len);
+			}
+			u32 bytes = 0;
+			if (const char* err = oracle_watch_arm(frames, port, ranges, bytes))
+				out = std::string("ERR ") + err + "\n";
+			else
+				out = "OK bytes=" + std::to_string(bytes) + " frames=" + std::to_string(frames) + " port=" + std::to_string(port) + "\n";
+			return true;
+		}
+		if (cmd == "WATCH_READ")
+		{
+			// "WATCH_READ": the ring's summary. "WATCH_READ <first> <count>": those records, 0 the
+			// oldest held, as hex (decimal numbers, as flips are). Only at a pause, so the ring holds
+			// still from one read to the next.
+			const std::vector<std::string> w = arg.empty() ? std::vector<std::string>{} : sky_words(arg);
+			u64 first = 0, count = 0;
+			if (!(w.empty() || (w.size() == 2 && sky_parse_flip(w[0], first) && sky_parse_flip(w[1], count))))
+			{
+				out = "ERR bad_args\n";
+				return true;
+			}
+			if (!Emu.IsPaused())
+			{
+				out = "ERR not_paused\n";
+				return true;
+			}
+			if (const char* err = oracle_watch_records(w.empty(), first, count, out))
+				out = std::string("ERR ") + err + "\n";
+			return true;
+		}
+		if (cmd == "WATCH_CLEAR")
+		{
+			if (!arg.empty())
+			{
+				out = "ERR bad_args\n";
+				return true;
+			}
+			oracle_watch_clear();
+			out = "OK\n";
+			return true;
+		}
+		return false;
+	}
