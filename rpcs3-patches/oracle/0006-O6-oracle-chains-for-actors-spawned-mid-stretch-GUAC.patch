+	void oracle_chain_put_be(u8* at, u32 v)
+	{
+		for (int i = 3; i >= 0; i--, v >>= 8)
+			at[i] = static_cast<u8>(v);
+	}
+
+	// The big-endian word at `addr`: 4-aligned and readable, else false.
+	bool oracle_chain_word(u64 addr, u32& out)
+	{
+		if (addr % 4 || addr + 4 > 0x1'0000'0000ull || !vm::check_addr(static_cast<u32>(addr), vm::page_readable, 4))
+			return false;
+		const u8* p = static_cast<const u8*>(vm::base(static_cast<u32>(addr)));
+		out = (u32{p[0]} << 24) | (u32{p[1]} << 16) | (u32{p[2]} << 8) | u32{p[3]};
+		return true;
+	}
+
+	// FNV-1a over the NUL-terminated string at `at`; false when it isn't readable or runs past
+	// oracle_chain_max_name bytes.
+	bool oracle_chain_name_hash(u32 at, u32& out)
+	{
+		u32 h = 0x811c9dc5u;
+		for (u32 i = 0; i < oracle_chain_max_name; i++)
+		{
+			const u64 a = u64{at} + i;
+			if (a >= 0x1'0000'0000ull || ((i == 0 || (a & 0xfff) == 0) && !vm::check_addr(static_cast<u32>(a), vm::page_readable, 1)))
+				return false;
+			const u8 c = *static_cast<const u8*>(vm::base(static_cast<u32>(a)));
+			if (!c)
+			{
+				out = h;
+				return true;
+			}
+			h = (h ^ c) * 0x01000193u;
+		}
+		return false;
+	}
+
+	// `hops` from `cur`: 0 once every one held (`cur` the object reached), else the 1-based hop that
+	// didn't: a pointer unreadable or null, an object not starting with its word, a list without the
+	// name searched for (or past oracle_chain_max_scan elements).
+	usz oracle_chain_follow(u32& cur, const std::vector<oracle_chain_hop>& hops)
+	{
+		for (usz i = 0; i < hops.size(); i++)
+		{
+			const oracle_chain_hop& h = hops[i];
+			if (!h.search)
+			{
+				u32 next = 0, w = 0;
+				if (!oracle_chain_word(u64{cur} + h.off, next) || next == 0 || (h.check && (!oracle_chain_word(next, w) || w != h.word)))
+					return i + 1;
+				cur = next;
+				continue;
+			}
+			u32 n = 0, arr = 0;
+			if (!oracle_chain_word(u64{cur} + h.count, n) || !oracle_chain_word(u64{cur} + h.array, arr) || n > oracle_chain_max_scan)
+				return i + 1;
+			bool found = false;
+			for (u32 k = 0; k < n && !found; k++)
+			{
+				u32 e = 0, name = 0, hash = 0;
+				if (oracle_chain_word(u64{arr} + 4 * k, e) && e && oracle_chain_word(u64{e} + h.name, name) && name &&
+					oracle_chain_name_hash(name, hash) && hash == h.hash)
+				{
+					cur = e;
+					found = true;
+				}
+			}
+			if (!found)
+				return i + 1;
+		}
+		return 0;
+	}
+
+	// An item's key: its probe's word, or the hash of the name that word points at.
+	bool oracle_chain_key(u32 item, const oracle_chain_probe& p, u32& key)
+	{
+		u32 cur = item, w = 0;
+		if (oracle_chain_follow(cur, p.hops) || !oracle_chain_word(u64{cur} + p.off, w))
+			return false;
+		if (!p.hashed)
+		{
+			key = w;
+			return true;
+		}
+		return w && oracle_chain_name_hash(w, key);
+	}
+
+	struct oracle_chain_counts
+	{
+		u32 status = 0, listed = 0, unread = 0, matched = 0, kept = 0;
+	};
+
+	// The chain's block as memory holds it now, into `out` (c.bytes of it): its header (the status,
+	// the list's count, the items whose key didn't read, the items the filter matched, the items kept,
+	// each a big-endian u32) and each kept item in list order (its address, its index in the list,
+	// the value it matched, a mask of its ranges that didn't read, then its ranges back to back), the
+	// rest zeros. The status is 0 when the list was read, else the 1-based link that broke: a path
+	// hop, then the count word, the array pointer and a count past oracle_chain_max_list.
+	oracle_chain_counts oracle_chain_block(const oracle_chain& c, u8* out)
+	{
+		std::memset(out, 0, c.bytes);
+		oracle_chain_counts n;
+		u32 list = c.base, count = 0, arr = 0;
+		const usz hops = c.path.size();
+		if (const usz broke = oracle_chain_follow(list, c.path))
+			n.status = static_cast<u32>(broke);
+		else if (!oracle_chain_word(u64{list} + c.count, count))
+			n.status = static_cast<u32>(hops + 1);
+		else if (!oracle_chain_word(u64{list} + c.array, arr))
+			n.status = static_cast<u32>(hops + 2);
+		else if (count > oracle_chain_max_list)
+			n.status = static_cast<u32>(hops + 3);
+		if (!n.status)
+		{
+			n.listed = count;
+			u8* item = out + oracle_chain_header;
+			for (u32 k = 0; k < count; k++)
+			{
+				u32 e = 0, key = 0;
+				if (!oracle_chain_word(u64{arr} + 4 * k, e) || !e || !oracle_chain_key(e, c.key, key))
+				{
+					n.unread++;
+					continue;
+				}
+				const auto v = std::find(c.values.begin(), c.values.end(), key);
+				if (v == c.values.end())
+					continue;
+				n.matched++;
+				if (n.kept == c.items)
+					continue;
+				u32 missing = 0;
+				u8* at = item + oracle_chain_item_header;
+				for (usz r = 0; r < c.ranges.size(); r++)
+				{
+					const oracle_chain_probe& p = c.ranges[r];
+					u32 cur = e;
+					if (!oracle_chain_follow(cur, p.hops) && u64{cur} + p.off + p.len <= 0x1'0000'0000ull &&
+						vm::check_addr(static_cast<u32>(u64{cur} + p.off), vm::page_readable, p.len))
+						std::memcpy(at, vm::base(static_cast<u32>(u64{cur} + p.off)), p.len);
+					else
+						missing |= 1u << r;
+					at += p.len;
+				}
+				oracle_chain_put_be(item, e);
+				oracle_chain_put_be(item + 4, k);
+				oracle_chain_put_be(item + 8, static_cast<u32>(v - c.values.begin()));
+				oracle_chain_put_be(item + 12, missing);
+				item += c.item_bytes;
+				n.kept++;
+			}
+		}
+		oracle_chain_put_be(out, n.status);
+		oracle_chain_put_be(out + 4, n.listed);
+		oracle_chain_put_be(out + 8, n.unread);
+		oracle_chain_put_be(out + 12, n.matched);
+		oracle_chain_put_be(out + 16, n.kept);
+		return n;
+	}
