+
+namespace
+{
+	// 1 to `digits` characters of `base` (10 or 16) no greater than `max`: Skylander.cpp's
+	// sky_parse_num on a view.
+	bool oracle_chain_num(std::string_view s, u32 base, usz digits, u32 max, u32& out)
+	{
+		if (s.empty() || s.size() > digits)
+			return false;
+		u64 v = 0;
+		for (const char c : s)
+		{
+			u32 d;
+			if (c >= '0' && c <= '9')
+				d = static_cast<u32>(c - '0');
+			else if (base == 16 && c >= 'a' && c <= 'f')
+				d = static_cast<u32>(c - 'a' + 10);
+			else if (base == 16 && c >= 'A' && c <= 'F')
+				d = static_cast<u32>(c - 'A' + 10);
+			else
+				return false;
+			v = v * base + d;
+		}
+		if (v > max)
+			return false;
+		out = static_cast<u32>(v);
+		return true;
+	}
+
+	// `s` split at every `sep`; an empty part is kept (and refused by whoever parses it).
+	std::vector<std::string_view> oracle_chain_split(std::string_view s, char sep)
+	{
+		std::vector<std::string_view> parts;
+		usz at = 0;
+		while (true)
+		{
+			const usz i = s.find(sep, at);
+			parts.push_back(s.substr(at, i == umax ? umax : i - at));
+			if (i == umax)
+				return parts;
+			at = i + 1;
+		}
+	}
+
+	// A hop: `<off>`, `<off>=<word>` or `?<count>,<array>,<name>=<hash>` (offsets 1-4 hex digits,
+	// words and hashes 1-8).
+	bool oracle_chain_parse_hop(std::string_view s, oracle_chain_hop& h)
+	{
+		const std::vector<std::string_view> eq = oracle_chain_split(s, '=');
+		if (eq.size() > 2)
+			return false;
+		if (!s.empty() && s[0] == '?')
+		{
+			const std::vector<std::string_view> f = oracle_chain_split(eq[0].substr(1), ',');
+			h.search = true;
+			return eq.size() == 2 && f.size() == 3 && oracle_chain_num(f[0], 16, 4, 0xffff, h.count) &&
+				oracle_chain_num(f[1], 16, 4, 0xffff, h.array) && oracle_chain_num(f[2], 16, 4, 0xffff, h.name) &&
+				oracle_chain_num(eq[1], 16, 8, 0xffffffffu, h.hash);
+		}
+		h.check = eq.size() == 2;
+		return oracle_chain_num(eq[0], 16, 4, 0xffff, h.off) && (!h.check || oracle_chain_num(eq[1], 16, 8, 0xffffffffu, h.word));
+	}
+
+	bool oracle_chain_parse_hops(const std::vector<std::string_view>& parts, usz n, std::vector<oracle_chain_hop>& hops)
+	{
+		if (n > oracle_chain_max_hops)
+			return false;
+		hops.assign(n, {});
+		for (usz i = 0; i < n; i++)
+		{
+			if (!oracle_chain_parse_hop(parts[i], hops[i]))
+				return false;
+		}
+		return true;
+	}
+
+	// A path: `-` for none, else hops joined by `>`.
+	bool oracle_chain_parse_path(std::string_view s, std::vector<oracle_chain_hop>& hops)
+	{
+		if (s == "-")
+		{
+			hops.clear();
+			return true;
+		}
+		const std::vector<std::string_view> parts = oracle_chain_split(s, '>');
+		return oracle_chain_parse_hops(parts, parts.size(), hops);
+	}
+
+	// A key: hops joined by `>`, then `<off>` (the word) or `#<off>` (its name's hash).
+	bool oracle_chain_parse_key(std::string_view s, oracle_chain_probe& p)
+	{
+		const std::vector<std::string_view> parts = oracle_chain_split(s, '>');
+		std::string_view term = parts.back();
+		p.hashed = !term.empty() && term[0] == '#';
+		if (p.hashed)
+			term.remove_prefix(1);
+		return oracle_chain_parse_hops(parts, parts.size() - 1, p.hops) && oracle_chain_num(term, 16, 4, 0xffff, p.off);
+	}
+
+	// A range: hops joined by `>`, then `<off>+<len>` (the length decimal, 1 to oracle_chain_max_range).
+	bool oracle_chain_parse_range(std::string_view s, oracle_chain_probe& p)
+	{
+		const std::vector<std::string_view> parts = oracle_chain_split(s, '>');
+		const std::vector<std::string_view> term = oracle_chain_split(parts.back(), '+');
+		return term.size() == 2 && oracle_chain_parse_hops(parts, parts.size() - 1, p.hops) &&
+			oracle_chain_num(term[0], 16, 4, 0xffff, p.off) && oracle_chain_num(term[1], 10, 4, oracle_chain_max_range, p.len) && p.len;
+	}
+}
+
+// O6: CHAIN <slot> <items> <base> <path> <count> <array> <key> <values> [<range> ...]. Arms chain
+// `slot` (0-7), replacing the one there: from `base`, `path`'s hops to a list whose count word sits
+// at +`count` and whose array of item pointers at +`array`; each item whose `key` matches one of
+// `values` (hex words joined by `,`) is kept, up to `items` a record, with its `range`s. Refused
+// while a watch is armed (WATCH_CLEAR first), and when the path doesn't reach a list now. nullptr
+// and `out` its OK line (the block's bytes, the list's count and the items kept now), else the ERR
+// reason.
+const char* oracle_chain_arm(const std::string& arg, std::string& out)
+{
+	const std::vector<std::string_view> w = arg.empty() ? std::vector<std::string_view>{} : oracle_chain_split(arg, ' ');
+	if (w.size() < 8 || w.size() > 8 + oracle_chain_max_ranges)
+		return "bad_args";
+	u32 slot = 0;
+	oracle_chain c;
+	if (!oracle_chain_num(w[0], 10, 1, static_cast<u32>(oracle_chain_slots - 1), slot))
+		return "bad_slot";
+	if (!oracle_chain_num(w[1], 10, 3, oracle_chain_max_items, c.items) || !c.items)
+		return "bad_items";
+	if (!oracle_chain_num(w[2], 16, 8, 0xffffffffu, c.base) || !oracle_chain_parse_path(w[3], c.path) ||
+		!oracle_chain_num(w[4], 16, 4, 0xffff, c.count) || !oracle_chain_num(w[5], 16, 4, 0xffff, c.array) ||
+		!oracle_chain_parse_key(w[6], c.key))
+		return "bad_hop";
+	const std::vector<std::string_view> values = oracle_chain_split(w[7], ',');
+	if (values.size() > oracle_chain_max_values)
+		return "bad_values";
+	for (const std::string_view v : values)
+	{
+		u32 value = 0;
+		if (!oracle_chain_num(v, 16, 8, 0xffffffffu, value))
+			return "bad_values";
+		c.values.push_back(value);
+	}
+	c.item_bytes = oracle_chain_item_header;
+	for (usz i = 8; i < w.size(); i++)
+	{
+		oracle_chain_probe p;
+		if (!oracle_chain_parse_range(w[i], p))
+			return "bad_range";
+		c.item_bytes += p.len;
+		c.ranges.push_back(std::move(p));
+	}
+	const u64 bytes = oracle_chain_header + u64{c.items} * c.item_bytes;
+	if (bytes > oracle_chain_budget)
+		return "too_big";
+	c.bytes = static_cast<u32>(bytes);
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_watch_session();
+	oracle_watch_state& st = g_oracle_watch;
+	if (st.frames)
+		return "watching";
+	u64 others = 0;
+	for (u32 i = 0; i < oracle_chain_slots; i++)
+	{
+		if (i != slot && st.chains[i].armed)
+			others += st.chains[i].bytes;
+	}
+	if (others + bytes > oracle_chain_budget)
+		return "too_big";
+	std::vector<u8> scratch(c.bytes);
+	const oracle_chain_counts n = oracle_chain_block(c, scratch.data());
+	if (n.status)
+		return "no_list";
+	c.armed = true;
+	st.chains[slot] = std::move(c);
+	out = "OK slot=" + std::to_string(slot) + " bytes=" + std::to_string(bytes) + " listed=" + std::to_string(n.listed) +
+		" kept=" + std::to_string(n.kept) + "\n";
+	return nullptr;
+}
+
+// O6: CHAIN_CLEAR. Every chain dropped; refused while a watch is armed.
+const char* oracle_chain_clear()
+{
+	std::lock_guard lock(pad::g_pad_mutex);
+	oracle_watch_session();
+	if (g_oracle_watch.frames)
+		return "watching";
+	g_oracle_watch.chains = {};
+	return nullptr;
 }
 
