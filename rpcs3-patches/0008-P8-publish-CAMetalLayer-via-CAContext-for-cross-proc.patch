 rpcs3/Emu/Io/Skylander.cpp                   | 15 ++++
 rpcs3/Emu/RSX/VK/vkutils/metal_layer.h       |  6 ++
 rpcs3/Emu/RSX/VK/vkutils/surface_publish.mm  | 78 ++++++++++++++++++++
 rpcs3/Emu/RSX/VK/vkutils/swapchain_macos.hpp | 23 +++++-
 5 files changed, 128 insertions(+), 1 deletion(-)
 create mode 100644 rpcs3/Emu/RSX/VK/vkutils/surface_publish.mm

diff --git a/rpcs3/Emu/CMakeLists.txt b/rpcs3/Emu/CMakeLists.txt
index 045fa3076..9dfc64784 100644
--- a/rpcs3/Emu/CMakeLists.txt
+++ b/rpcs3/Emu/CMakeLists.txt
@@ -655,6 +655,7 @@ if(TARGET 3rdparty_vulkan)
     if(APPLE)
         target_sources(rpcs3_emu PRIVATE
             RSX/VK/vkutils/metal_layer.mm
+            RSX/VK/vkutils/surface_publish.mm
         )
     endif()
 endif()
@@ -700,6 +701,12 @@ if(APPLE)
     if (HAVE_CLOCK_GETTIME)
         target_compile_definitions(rpcs3_emu PUBLIC -DHAVE_CLOCK_GETTIME)
     endif()
+
+    # PLAN P8 — surface_publish.mm references the private CAContext class (QuartzCore)
+    # and CGSMainConnectionID (CoreGraphics). metal_layer.mm only needed plain message
+    # sends so these frameworks weren't on the link line before; the CAContext *class*
+    # symbol forces them. PUBLIC so the final rpcs3 binary inherits the link.
+    target_link_libraries(rpcs3_emu PUBLIC "-framework QuartzCore" "-framework CoreGraphics")
 endif()
 
 
