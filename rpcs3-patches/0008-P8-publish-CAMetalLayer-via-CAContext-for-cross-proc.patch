diff --git a/rpcs3/Emu/RSX/VK/vkutils/metal_layer.h b/rpcs3/Emu/RSX/VK/vkutils/metal_layer.h
index d587b55bf..1d9a5feea 100644
--- a/rpcs3/Emu/RSX/VK/vkutils/metal_layer.h
+++ b/rpcs3/Emu/RSX/VK/vkutils/metal_layer.h
@@ -1,2 +1,8 @@
 #pragma once
 void* GetCAMetalLayerFromMetalView(void* view);
+
+// PLAN P8 — bind a private CAContext to the existing CAMetalLayer and return its
+// contextId (a u32 token the launcher hosts via CALayerHost). Returns 0 when not in
+// our control mode (SKYLANDER_BORDERLESS unset) or on failure. Defined in
+// surface_publish.mm. See that file for the private-API rationale.
+extern "C" unsigned int sky_publish_metal_layer_context(void* metal_layer);
diff --git a/rpcs3/Emu/RSX/VK/vkutils/surface_publish.mm b/rpcs3/Emu/RSX/VK/vkutils/surface_publish.mm
new file mode 100644
index 000000000..317770aa8
--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/vkutils/surface_publish.mm
@@ -0,0 +1,78 @@
+// PLAN P8 — publish the game's CAMetalLayer to another process so our launcher can
+// host it via CALayerHost (the macOS surface-embed, mirroring the P2 WINDOW handle
+// publish). On macOS RPCS3 renders Vulkan -> MoltenVK -> Metal into the NSView's
+// CAMetalLayer; we bind a *private* CAContext to that existing layer and hand its
+// contextId (a u32 token) to the launcher over the AF_UNIX IPC. The launcher then
+// reconstructs the layer tree remotely with CALayerHost.
+//
+// This is a light-touch exposure: bind context, read id, return it. The id is
+// published ONCE at surface creation — a source dig proved the CAMetalLayer survives
+// every swapchain recreate / resize / resolution change, so there is no re-publish
+// hook. The CAContext is retained in a file-static for the process lifetime so the
+// remote host never loses the layer tree while the game runs.
+//
+// The private-API incantation (CGSMainConnectionID + +contextWithCGSConnection:options:)
+// is the one proven by tools/calayer-poc/. CAContext lives in QuartzCore;
+// CGSMainConnectionID in CoreGraphics — both already linked transitively on this target
+// (same frameworks metal_layer.mm relies on).
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wold-style-cast"
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+#pragma GCC diagnostic ignored "-Wmissing-declarations"
+#import <Foundation/Foundation.h>
+#import <QuartzCore/QuartzCore.h>
+#include <cstdlib>
+
+// --- PRIVATE API declarations (linked, but not in any public header) ----------
+// Returns this process's main CGSConnectionID. Lives in CoreGraphics.
+extern "C" unsigned int CGSMainConnectionID(void);
+
+// The server-side handle that owns a layer tree and exposes it for remote hosting.
+// Safari/Chrome use +contextWithCGSConnection:options:.
+@interface CAContext : NSObject
++ (instancetype)contextWithCGSConnection:(unsigned int)cid options:(NSDictionary*)opts;
+@property (readonly) unsigned int contextId;
+@property (strong) CALayer* layer;
+@end
+
+// Bind a private CAContext to `metal_layer` (an existing CAMetalLayer*, type-erased to
+// void* so no ObjC types leak into the C++ caller) and return its contextId. Retains the
+// CAContext for the process lifetime (the layer's lifetime — never released while the
+// game runs). Returns 0 if not in our control mode (SKYLANDER_BORDERLESS unset).
+extern "C" unsigned int sky_publish_metal_layer_context(void* metal_layer)
+{
+	// Gate behind SKYLANDER_BORDERLESS, exactly like P2/P7 — only publish in our
+	// controller mode so a stock-style launch is untouched.
+	if (!std::getenv("SKYLANDER_BORDERLESS"))
+	{
+		return 0;
+	}
+
+	if (!metal_layer)
+	{
+		return 0;
+	}
+
+	// Retain the published CAContext for the whole process: the remote CALayerHost
+	// must keep resolving this contextId for as long as the game renders.
+	static CAContext* s_published_ctx = nil;
+	if (s_published_ctx)
+	{
+		// Already published (defensive — the caller also guards publish-once).
+		return s_published_ctx.contextId;
+	}
+
+	CAContext* ctx = [CAContext contextWithCGSConnection:CGSMainConnectionID() options:@{}];
+	if (!ctx)
+	{
+		return 0;
+	}
+
+	ctx.layer = (CALayer*)metal_layer;
+	[ctx retain]; // hold for the process lifetime
+	s_published_ctx = ctx;
+
+	return ctx.contextId;
+}
+#pragma GCC diagnostic pop
diff --git a/rpcs3/Emu/RSX/VK/vkutils/swapchain_macos.hpp b/rpcs3/Emu/RSX/VK/vkutils/swapchain_macos.hpp
index e4485324d..61ea9dc28 100644
--- a/rpcs3/Emu/RSX/VK/vkutils/swapchain_macos.hpp
+++ b/rpcs3/Emu/RSX/VK/vkutils/swapchain_macos.hpp
@@ -3,6 +3,14 @@
 #include "swapchain_core.h"
 #include "metal_layer.h"
 
+#include <atomic>
+
+// PLAN P8 — the published CAMetalLayer CAContext id, defined in emucore (Skylander.cpp,
+// beside g_game_window_handle) and read by the IPC SURFACE command. Set ONCE here at
+// surface creation (the layer survives every swapchain recreate / resize / resolution
+// change, so no re-publish is needed).
+extern std::atomic<unsigned int> g_game_surface_context_id;
+
 namespace vk
 {
 #if defined(__APPLE__)
@@ -12,10 +20,23 @@ namespace vk
 	[[maybe_unused]] static
 	VkSurfaceKHR make_WSI_surface(VkInstance vk_instance, display_handle_t window_handle, WSI_config* /*config*/)
 	{
+		void* metal_layer = GetCAMetalLayerFromMetalView(window_handle);
+
+		// PLAN P8 — publish the layer's CAContext exactly once (the contextId is stable
+		// across swapchain recreates). Gated internally by SKYLANDER_BORDERLESS; a no-op
+		// returning 0 outside our control mode.
+		if (g_game_surface_context_id.load() == 0)
+		{
+			if (const unsigned int cid = sky_publish_metal_layer_context(metal_layer))
+			{
+				g_game_surface_context_id.store(cid);
+			}
+		}
+
 		VkSurfaceKHR result = VK_NULL_HANDLE;
 		VkMetalSurfaceCreateInfoEXT createInfo = {};
 		createInfo.sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
-		createInfo.pLayer = GetCAMetalLayerFromMetalView(window_handle);
+		createInfo.pLayer = metal_layer;
 
 		CHECK_RESULT(vkCreateMetalSurfaceEXT(vk_instance, &createInfo, NULL, &result));
 		return result;
