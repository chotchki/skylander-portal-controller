From 755a7a21569a6b2aa9fd289fc91e9f4d27c115de Mon Sep 17 00:00:00 2001
From: Christopher Hotchkiss <chris@hotchkiss.io>
Date: Fri, 29 May 2026 16:34:01 -0700
Subject: [PATCH 2/5] P2: borderless, no-focus-steal game window + native
 handle over IPC
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

gs_frame: when $SKYLANDER_BORDERLESS is set, create the game window with
Qt::FramelessWindowHint | Qt::WindowDoesNotAcceptFocus, and publish the native
winId() into g_game_window_handle (defined in Emu/Io/Skylander.cpp by P1) right
after create(), so the controller can read it via the IPC WINDOW command and
position / embed the window without stealing focus.

The window is created Hidden and first surfaces in gs_frame::show(), where a
normal show() raises it to the TOP of the z-order — flashing the still-compiling
viewport over the controller's launcher overlay for a frame before the controller
can push it back under. WindowDoesNotAcceptFocus stops focus-steal but not that
z-order raise, so show() also inserts the window at HWND_BOTTOM (one-shot,
no-activate, _WIN32 + env-gated). The compile then happens beneath the opaque
overlay and never surfaces; ongoing placement stays the controller's job over IPC.

The global is extern-declared inline in the two .cpp that touch it rather than
in the widely-included GSFrameBase.h, to keep the rebuild tiny.

Shallow + additive. Depends on P1 (defines the global).
PLAN 16.1.3 / 16.4.x / 16.6.2.x.
---
 rpcs3/rpcs3qt/gs_frame.cpp | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/rpcs3/rpcs3qt/gs_frame.cpp b/rpcs3/rpcs3qt/gs_frame.cpp
index 5d65a2c93..584b533e8 100644
--- a/rpcs3/rpcs3qt/gs_frame.cpp
+++ b/rpcs3/rpcs3qt/gs_frame.cpp
@@ -65,6 +65,11 @@ namespace pad
 	extern atomic_t<bool> g_home_menu_requested;
 }
 
+// PLAN 16.1.3 — defined in emucore (Emu/Io/Skylander.cpp); published here on window creation
+// so the controller can read it over IPC (avoids touching the widely-included GSFrameBase.h).
+#include <atomic>
+extern std::atomic<unsigned long long> g_game_window_handle;
+
 gs_frame::gs_frame(QScreen* screen, const QRect& geometry, const QIcon& appIcon, std::shared_ptr<gui_settings> gui_settings, bool force_fullscreen)
 	: QWindow()
 	, m_initial_geometry(geometry)
@@ -115,12 +120,21 @@ gs_frame::gs_frame(QScreen* screen, const QRect& geometry, const QIcon& appIcon,
 	setGeometry(geometry);
 	setTitle(QString::fromStdString(m_window_title));
 
+	// PLAN 16.1.3 — controller-embedded play: borderless + no focus-steal (env-gated, additive).
+	if (::getenv("SKYLANDER_BORDERLESS"))
+	{
+		setFlags(flags() | Qt::FramelessWindowHint | Qt::WindowDoesNotAcceptFocus);
+	}
+
 	if (g_cfg.video.renderer != video_renderer::opengl)
 	{
 		// Do not display the window before OpenGL is configured!
 		// This works fine in windows and X11 but wayland-egl will crash later.
 		setVisibility(startup_visibility);
 		create();
+
+		// PLAN 16.1.3 — publish the native window handle for the controller (read via the IPC WINDOW cmd).
+		g_game_window_handle = static_cast<unsigned long long>(this->winId());
 	}
 
 	load_gui_settings();
@@ -726,6 +740,23 @@ void gs_frame::show()
 				setVisibility(visibility);
 			}
 		}
+
+#ifdef _WIN32
+		// PLAN 16.6.2.x — controller-embedded play (env-gated, additive). The game
+		// window is created Hidden (above) and first surfaces here once the renderer
+		// is ready. A normal show() raises it to the TOP of the z-order, flashing the
+		// still-compiling viewport over the controller's launcher overlay for a frame
+		// before the controller can push it back under. Insert at the BOTTOM of the
+		// z-order at the show moment so the compile happens beneath the opaque overlay
+		// and never surfaces. One-shot + no-activate; ongoing placement stays the
+		// controller's job over IPC. WindowDoesNotAcceptFocus (set in the ctor) stops
+		// focus-steal but not this z-order raise — hence the explicit push here.
+		if (::getenv("SKYLANDER_BORDERLESS"))
+		{
+			SetWindowPos(reinterpret_cast<HWND>(this->winId()), HWND_BOTTOM, 0, 0, 0, 0,
+				SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+		}
+#endif
 	});
 }
 
