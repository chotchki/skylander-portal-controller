+// ============================================================================
+// Skylander IPC (PLAN 16.1.2 / 16.3.1). Drive g_skyportal over an AF_UNIX socket
+// so the controller never touches the Skylanders Manager dialog. Also exposes a
+// clean STATE query + a 1 Hz heartbeat (Emu status + boot/shader-compile progress
+// + RSX frame index) so the controller reads emulator state programmatically
+// instead of scraping logs. Shallow + additive; inline here so no new
+// .cpp/vcxproj entry. WSAStartup is done globally in rpcs3.cpp. Mirrors the
+// AF_UNIX pattern already used by Emu/GDB.cpp.
+// ============================================================================
+
+u8 sky_portal::first_free_slot()
+{
+	std::lock_guard lock(sky_mutex);
+	for (u8 i = 0; i < 8; i++)
+	{
+		if ((skylanders[i].status & 1) == 0)
+			return i;
+	}
+	return 0xFF;
+}
+
+bool sky_portal::slot_loaded(u8 sky_num)
+{
+	if (sky_num >= 8)
+		return false;
+	std::lock_guard lock(sky_mutex);
+	return (skylanders[sky_num].status & 1) != 0;
+}
+
+u32 sky_portal::slot_serial(u8 sky_num)
+{
+	if (sky_num >= 8)
+		return 0;
+	std::lock_guard lock(sky_mutex);
+	return (skylanders[sky_num].status & 1) ? skylanders[sky_num].last_id : 0;
+}
+
+namespace
+{
+#ifdef _WIN32
+	void sky_close(int s) { closesocket(s); }
+#else
+	void sky_close(int s) { ::close(s); }
+#endif
+
+	std::string sky_state_name(system_state s)
+	{
+		switch (s)
+		{
+		case system_state::stopped:  return "stopped";
+		case system_state::loading:  return "loading";
+		case system_state::stopping: return "stopping";
+		case system_state::running:  return "running";
+		case system_state::paused:   return "paused";
+		case system_state::frozen:   return "frozen";
+		case system_state::ready:    return "ready";
+		case system_state::starting: return "starting";
+		}
+		return "unknown";
+	}
+
+	// "<prefix> status=<s> frames=<n> progr=<pdone>/<ptotal> seg=<fdone>/<ftotal>"
+	// ready-to-use := status==running && progr complete && frames advancing.
+	std::string sky_state_line(const char* prefix)
+	{
+		u64 frames = 0;
+		if (rsx::thread* r = rsx::get_current_renderer())
+			frames = r->int_flip_index;
+
+		const u32 pdone = g_progr_pdone, ptotal = g_progr_ptotal;
+		const u32 fdone = g_progr_fdone, ftotal = g_progr_ftotal;
+
+		std::string s = prefix;
+		s += " status=" + sky_state_name(Emu.GetStatus());
+		s += " frames=" + std::to_string(frames);
+		s += " progr=" + std::to_string(pdone) + "/" + std::to_string(ptotal);
+		s += " seg=" + std::to_string(fdone) + "/" + std::to_string(ftotal);
+		s += "\n";
+		return s;
+	}
+
+	void sky_ipc_handle(const std::string& line, std::string& out)
+	{
+		const usz sp = line.find(' ');
+		const std::string cmd = line.substr(0, sp);
+		const std::string arg = (sp == umax) ? std::string{} : line.substr(sp + 1);
+
+		if (cmd == "PING")
+		{
+			out = "PONG\n";
+		}
+		else if (cmd == "STATE")
+		{
+			out = sky_state_line("OK");
+		}
+		else if (cmd == "WINDOW")
+		{
+			// PLAN 16.1.3 — native game-window handle (hex) for controller positioning/embed.
+			char hx[24]{};
+			std::snprintf(hx, sizeof(hx), "%llX", g_game_window_handle.load());
+			out = std::string("OK handle=") + hx + "\n";
+		}
+		else if (cmd == "STATUS")
+		{
+			out = "OK";
+			for (u8 i = 0; i < 8; i++)
+			{
+				out += ' ';
+				out += std::to_string(i);
+				if (g_skyportal.slot_loaded(i))
+				{
+					char hex[16]{};
+					std::snprintf(hex, sizeof(hex), ":%08X", g_skyportal.slot_serial(i));
+					out += hex;
+				}
+				else
+				{
+					out += ":empty";
+				}
+			}
+			out += "\n";
+		}
+		else if (cmd == "LOAD")
+		{
+			// arg = absolute path to a working-copy .sky. Mirrors load_skylander_path().
+			if (g_skyportal.first_free_slot() == 0xFF)
+			{
+				out = "ERR portal_full\n";
+				return;
+			}
+			fs::file sky_file(arg, fs::read + fs::write + fs::lock);
+			if (!sky_file)
+			{
+				out = "ERR open_failed\n";
+				return;
+			}
+			std::array<u8, 0x40 * 0x10> data{};
+			if (sky_file.read(data.data(), data.size()) != data.size())
+			{
+				out = "ERR read_failed\n";
+				return;
+			}
+			const u8 slot = g_skyportal.load_skylander(data.data(), std::move(sky_file));
+			out = "OK slot=" + std::to_string(slot) + "\n";
+		}
+		else if (cmd == "CLEAR")
+		{
+			const int slot = arg.empty() ? -1 : std::atoi(arg.c_str());
+			if (slot < 0 || slot > 7)
+			{
+				out = "ERR bad_slot\n";
+				return;
+			}
+			out = g_skyportal.remove_skylander(static_cast<u8>(slot)) ? "OK\n" : "ERR not_loaded\n";
+		}
+		else
+		{
+			out = "ERR unknown_cmd\n";
+		}
+	}
+
+	void sky_ipc_conn(int c)
+	{
+		std::string inbuf;
+		char buf[512];
+		for (;;)
+		{
+			fd_set rfds;
+			FD_ZERO(&rfds);
+			FD_SET(c, &rfds);
+			timeval tv{};
+			tv.tv_sec = 1; // 1 Hz heartbeat cadence
+
+			const int sel = select(c + 1, &rfds, nullptr, nullptr, &tv);
+			if (sel < 0)
+				break;
+
+			if (sel == 0)
+			{
+				const std::string hb = sky_state_line("HB");
+				if (send(c, hb.data(), static_cast<int>(hb.size()), 0) < 0)
+					break;
+				continue;
+			}
+
+			const int n = static_cast<int>(recv(c, buf, sizeof(buf), 0));
+			if (n <= 0)
+				break;
+
+			inbuf.append(buf, static_cast<usz>(n));
+			usz nl;
+			while ((nl = inbuf.find('\n')) != umax)
+			{
+				std::string l = inbuf.substr(0, nl);
+				while (!l.empty() && (l.back() == '\r' || l.back() == ' '))
+					l.pop_back();
+				inbuf.erase(0, nl + 1);
+
+				std::string out;
+				sky_ipc_handle(l, out);
+				if (send(c, out.data(), static_cast<int>(out.size()), 0) < 0)
+				{
+					sky_close(c);
+					return;
+				}
+			}
+		}
+		sky_close(c);
+	}
+
+	std::string sky_ipc_path()
+	{
+		if (const char* e = std::getenv("SKYLANDER_IPC_PATH"))
+			return e;
+#ifdef _WIN32
+		const char* tmp = std::getenv("TEMP");
+		return std::string(tmp ? tmp : "C:\\Windows\\Temp") + "\\rpcs3-skylander.sock";
+#else
+		return "/tmp/rpcs3-skylander.sock";
+#endif
+	}
+
+	void sky_ipc_serve()
+	{
+		const std::string path = sky_ipc_path();
+
+		const int srv = static_cast<int>(socket(AF_UNIX, SOCK_STREAM, 0));
+		if (srv < 0)
+		{
+			skylander_log.error("Skylander IPC: socket() failed");
+			return;
+		}
+
+		fs::remove_file(path); // drop a stale socket file before bind
+
+		sockaddr_un sa{};
+		sa.sun_family = AF_UNIX;
+		strcpy_trunc(sa.sun_path, path);
+
+		if (bind(srv, reinterpret_cast<sockaddr*>(&sa), sizeof(sa)) != 0)
+		{
+			skylander_log.error("Skylander IPC: bind '%s' failed", path);
+			sky_close(srv);
+			return;
+		}
+		if (listen(srv, 4) != 0)
+		{
+			skylander_log.error("Skylander IPC: listen failed");
+			sky_close(srv);
+			return;
+		}
+
+		skylander_log.success("Skylander IPC: listening on AF_UNIX %s", path);
+
+		for (;;)
+		{
+			const int c = static_cast<int>(accept(srv, nullptr, nullptr));
+			if (c < 0)
+				continue;
+			std::thread(sky_ipc_conn, c).detach();
+		}
+	}
+
+	void skylander_ipc_start_once()
+	{
+		static std::once_flag once;
+		std::call_once(once, [] { std::thread(sky_ipc_serve).detach(); });
+	}
+}
+
 usb_device_skylander::usb_device_skylander(const std::array<u8, 7>& location)
 	: usb_device_emulated(location)
 {
@@ -200,6 +504,9 @@ usb_device_skylander::usb_device_skylander(const std::array<u8, 7>& location)
 	config0.add_node(UsbDescriptorNode(USB_DESCRIPTOR_HID, UsbDeviceHID{0x0111, 0x00, 0x01, 0x22, 0x001d}));
 	config0.add_node(UsbDescriptorNode(USB_DESCRIPTOR_ENDPOINT, UsbDeviceEndpoint{0x81, 0x03, 0x40, 0x01}));
 	config0.add_node(UsbDescriptorNode(USB_DESCRIPTOR_ENDPOINT, UsbDeviceEndpoint{0x02, 0x03, 0x40, 0x01}));
+
+	// PLAN 16.1.2 — start the portal IPC listener once per RPCS3 process.
+	skylander_ipc_start_once();
 }
 
 usb_device_skylander::~usb_device_skylander()
