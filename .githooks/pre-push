#!/usr/bin/env bash
# Opt-in local pre-push hook (PLAN 10.5.5). Activated via:
#
#   git config core.hooksPath .githooks
#
# Runs the same checks the `clippy-build-test` CI lane runs on every
# push, catching most regressions before they hit GitHub. Skip with
# `git push --no-verify` for WIP branches.
#
# Order matters: cheapest first so failures fail fast.
#   1. cargo fmt --check (workspace + phone) — seconds.
#   2. cargo check --workspace — fast incremental.
#   3. cargo clippy --workspace --all-targets -- -D warnings — mirrors the CI
#      lint lane (added 2026-06-11: a clippy-only regression in an example
#      slipped past check+test+fmt and was only caught by CI — after a release
#      tag had already been cut. Worth the extra ~30 s).
#   4. cargo test --workspace — typically <60 s on warm cargo cache,
#      slower on cold. Run through ram-tmpdir.sh (openspec AQ.35): TMPDIR
#      on a 2 GiB APFS RAM disk made for the run and detached after, so the
#      tests' temp-dir flushes don't wait on the SSD (34.5-39.6 s →
#      16.6-19.8 s). Mac only; elsewhere the command runs as it is.
# Between 1 and 2, guards that read cargo's metadata and build nothing:
#   - one-bevy.sh (openspec AQ.30): guacamole's build and its tests resolve
#     the crates they share with Bevy to the same features, so the tests
#     don't build a second Bevy and Avian (~0.5 s).
#   - no-doctests.sh (openspec AQ.36): the libraries skip their empty doc-test
#     runs (`doctest = false`), so a doc code block rustdoc would run fails
#     here rather than going unrun (~0.5 s).

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

step() {
  printf "\n\033[1;36m[pre-push] %s\033[0m\n" "$*"
}

step "cargo fmt --all --check (workspace)"
cargo fmt --all --check

step "cargo fmt --all --check (phone)"
( cd phone && cargo fmt --all --check )

step "one Bevy for guacamole's build and tests (.githooks/one-bevy.sh)"
.githooks/one-bevy.sh

step "no doctest left unrun (.githooks/no-doctests.sh)"
.githooks/no-doctests.sh

step "cargo check --workspace"
cargo check --workspace

step "cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

step "cargo test --workspace (TMPDIR on a RAM disk: .githooks/ram-tmpdir.sh)"
.githooks/ram-tmpdir.sh cargo test --workspace

printf "\n\033[1;32m[pre-push] all checks passed.\033[0m\n"
