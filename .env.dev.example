# Copy to `.env.dev` and fill in.
# Only loaded when the server is built with the `dev-tools` feature (default).

# Absolute path to rpcs3.exe. The server reads the companion config/games.yml.
RPCS3_EXE=C:/emuluators/rpcs3/rpcs3.exe

# Root of the firmware pack (the folder containing the game subfolders).
FIRMWARE_PACK_ROOT=C:/Users/chris/workspace/Skylanders Characters Pack for RPCS3

# Optional — defaults to <RPCS3_EXE dir>/config/games.yml.
# GAMES_YAML=C:/emuluators/rpcs3/config/games.yml

# Optional — HTTP port. Defaults to 8765.
# BIND_PORT=8765

# Optional — set to `mock` to swap in the mock driver (no RPCS3 needed).
# SKYLANDER_PORTAL_DRIVER=mock

# Optional — `desktop` opens a resizable window instead of borderless full screen.
# WINDOW_MODE=desktop

# --- guacamole (`cargo run -p guacamole`) ---
# Uses BIND_PORT, WINDOW_MODE, DATA_ROOT (default `data`) and the GUAC_* keys
# in this section, never RPCS3_EXE or FIRMWARE_PACK_ROOT (it reads PHONE_DIST
# too, but nothing uses it: the phone is embedded). Folders holding the disc
# dumps, in the OS's path-list form (`:`-separated on macOS, `;` on Windows);
# set, it overrides the folders guacamole stored and its TV skips setup.
# GUAC_DUMP_DIRS=/Users/you/Library/Application Support/rpcs3/game_discs

# The extract root (openspec AB): a folder OUTSIDE any git checkout, required for a Giants pick to extract and play intros.
# GUAC_EXTRACT_DIR=/Users/you/guacamole-extract

# Optional — ffmpeg for the intro transcode; unset looks beside the binary, on PATH, then in Homebrew's bin folders.
# GUAC_FFMPEG=/opt/homebrew/bin/ffmpeg

# Optional — ms the intro video waits for the sound path (0-1000); unset is the provisional 43.
# GUAC_OUTPUT_LATENCY_MS=43

# Written by the e2e harness, read only by a `test-hooks` build: "<TITLE_ID> <APP_VER> <manifest hash>" trusted beside the known dumps.
# GUAC_TEST_KNOWN_DUMP=BLUS30968 01.00 <64 hex>

# Not read from this file: GUAC_MUTE=1 in the process env mutes intros in a dev build (the e2e harness sets it).

# --- Guacamole's #[ignore]d disc tests ---
# The Giants (BLUS30968) dump, the folder holding PS3_GAME; read-only. Disc tests also write throwaway extracts under GUAC_EXTRACT_DIR.
# GUAC_GIANTS_DUMP=/Users/you/Library/Application Support/rpcs3/game_discs/Skylanders Giants
